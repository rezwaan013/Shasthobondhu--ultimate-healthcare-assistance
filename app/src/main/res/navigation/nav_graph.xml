<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_login">

    <!-- Auth -->
    <fragment
        android:id="@+id/nav_login"
        android:name="com.shasthobondhu.app.ui.fragments.auth.login.LoginFragment"
        android:label="@string/action_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/nav_register" />
        <action
            android:id="@+id/action_login_to_forgot"
            app:destination="@id/nav_forgot_password" />
    </fragment>

    <fragment
        android:id="@+id/nav_register"
        android:name="com.shasthobondhu.app.ui.fragments.auth.RegistrationFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_registration" />

    <fragment
        android:id="@+id/nav_forgot_password"
        android:name="com.shasthobondhu.app.ui.fragments.auth.ForgotPasswordFragment"
        android:label="@string/forgot_title"
        tools:layout="@layout/fragment_forgot_password" />

    <!-- Main features -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.shasthobondhu.app.ui.fragments.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_donors"
        android:name="com.shasthobondhu.app.ui.fragments.donors.DonorFragment"
        android:label="@string/nav_donors"
        tools:layout="@layout/fragment_donors" />

    <fragment
        android:id="@+id/nav_requests"
        android:name="com.shasthobondhu.app.ui.fragments.requests.RequestFragment"
        android:label="@string/nav_requests"
        tools:layout="@layout/fragment_requests" />

    <fragment
        android:id="@+id/nav_hospitals"
        android:name="com.shasthobondhu.app.ui.fragments.hospitals.HospitalFragment"
        android:label="@string/nav_hospitals"
        tools:layout="@layout/fragment_hospitals" />

    <fragment
        android:id="@+id/nav_medicines"
        android:name="com.shasthobondhu.app.ui.fragments.medicines.MedicineFragment"
        android:label="@string/nav_medicines"
        tools:layout="@layout/fragment_medicines" />

    <fragment
        android:id="@+id/nav_notifications"
        android:name="com.shasthobondhu.app.ui.fragments.notifications.NotificationFragment"
        android:label="@string/notifications_title"
        tools:layout="@layout/fragment_notifications" />

    <!-- User actions -->
    <fragment
        android:id="@+id/nav_donor_register"
        android:name="com.shasthobondhu.app.ui.fragments.donors.DonorRegisterFragment"
        android:label="@string/donor_register_title"
        tools:layout="@layout/fragment_donor_register" />

    <fragment
        android:id="@+id/nav_create_request"
        android:name="com.shasthobondhu.app.ui.fragments.requests.CreateRequestFragment"
        android:label="@string/create_request_title"
        tools:layout="@layout/fragment_create_request" />

    <!-- Owner dashboards -->
    <fragment
        android:id="@+id/nav_pharmacy_dashboard"
        android:name="com.shasthobondhu.app.ui.fragments.pharmacy.PharmacyDashboardFragment"
        android:label="@string/pharmacy_dashboard_title"
        tools:layout="@layout/fragment_pharmacy_dashboard" />

    <fragment
        android:id="@+id/nav_hospital_dashboard"
        android:name="com.shasthobondhu.app.ui.fragments.hospital.HospitalDashboardFragment"
        android:label="@string/hospital_dashboard_title"
        tools:layout="@layout/fragment_hospital_dashboard" />

</navigation>
