rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /donors/{donorId} {
      allow read: if true;
      allow create, update: if signedIn();
    }

    match /blood_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if signedIn();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if false;
    }

    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Small authenticated records created from the in-app lab verification screen.
    match /lab_demo_events/{eventId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.source == "android_lab_demo";
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // Only the Cloud Functions service account may touch reset codes.
    match /password_resets/{docId} {
      allow read, write: if false;
    }
  }
}
